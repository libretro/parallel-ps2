	$(LRPS2_DIR)/SPU2/spu2sys.c

SOURCES_CXX += \

# pcsx2 CPU recompilers. x86_64 uses the x86 dynarec; aarch64 uses the native
# arm64 EE/IOP/VU recompilers + NEON VIF unpack transplanted from ARMSX2 (the
# x86 sources have no arm64 backend). CpuState.c only defines the EE/IOP/FPU
# register state the interpreter needs too, so it is built on both. Mirrors the
# `if(NOT _M_X86)` source swap in pcsx2/CMakeLists.txt.
ifeq ($(IS_ARM64), 1)
# JitHash.c is portable: on non-x86 it compiles to the exported
# pcsx2_jithash_dump stub that libretro/main.c calls unconditionally from
# retro_deinit. Dropping it here is an aarch64 link error -- cmake's
# pcsx2/CMakeLists.txt already keeps it in the arm64 list for this reason.
SOURCES_C += \
	$(LRPS2_DIR)/x86/CpuState.c \
	$(LRPS2_DIR)/x86/JitHash.c \
	$(LRPS2_DIR)/arm64/a64emit.c \
	$(LRPS2_DIR)/arm64/AsmHelpers.c \
	$(LRPS2_DIR)/arm64/aBlocks.c \
	$(LRPS2_DIR)/arm64/Vif_UnpackNEON.c \
	$(LRPS2_DIR)/arm64/Vif_Dynarec_arm64.c \
	$(LRPS2_DIR)/arm64/recR3000A_arm64.c \
	$(LRPS2_DIR)/arm64/recR5900_arm64.c \
	$(LRPS2_DIR)/arm64/aVU.c
else
# pcsx2/x86 (recompilers), all C.
SOURCES_C += \
	$(LRPS2_DIR)/x86/CpuState.c \
	$(LRPS2_DIR)/x86/BaseblockEx.c \
	$(LRPS2_DIR)/x86/iCOP0.c \
	$(LRPS2_DIR)/x86/iCore.c \
	$(LRPS2_DIR)/x86/iFPU.c \
	$(LRPS2_DIR)/x86/iFPUd.c \
	$(LRPS2_DIR)/x86/iMMI.c \
	$(LRPS2_DIR)/x86/JitHash.c \
	$(LRPS2_DIR)/x86/iR3000A.c \
	$(LRPS2_DIR)/x86/iR3000Atables.c \
	$(LRPS2_DIR)/x86/iR5900Analysis.c \
	$(LRPS2_DIR)/x86/iR5900Misc.c \
	$(LRPS2_DIR)/x86/ix86-32/iCore-32.c \
	$(LRPS2_DIR)/x86/ix86-32/iR5900-32.c \
	$(LRPS2_DIR)/x86/ix86-32/iR5900Arit.c \
	$(LRPS2_DIR)/x86/ix86-32/iR5900AritImm.c \
	$(LRPS2_DIR)/x86/ix86-32/iR5900Branch.c \
	$(LRPS2_DIR)/x86/ix86-32/iR5900Jump.c \
	$(LRPS2_DIR)/x86/ix86-32/iR5900LoadStore.c \
	$(LRPS2_DIR)/x86/ix86-32/iR5900Move.c \
	$(LRPS2_DIR)/x86/ix86-32/iR5900MultDiv.c \
	$(LRPS2_DIR)/x86/ix86-32/iR5900Shift.c \
	$(LRPS2_DIR)/x86/ix86-32/iR5900Templates.c \
	$(LRPS2_DIR)/x86/ix86-32/recVTLB.c \
	$(LRPS2_DIR)/x86/microVU.c \
	$(LRPS2_DIR)/x86/newVif_Dynarec.c \
	$(LRPS2_DIR)/x86/newVif_UnpackSSE.c
endif

