	$(LRPS2_DIR)/GS/Renderers/OpenGL/GLPipeline.c \
	$(LRPS2_DIR)/GS/Renderers/OpenGL/GLShaderSource.c \
	$(LRPS2_DIR)/GS/Renderers/OpenGL/GLState.c \
	$(LRPS2_DIR)/GS/Renderers/OpenGL/GLStreamBuffer.c \
	$(LRPS2_DIR)/GS/Renderers/OpenGL/GLTextureFormat.c \
	$(LRPS2_DIR)/GS/Renderers/OpenGL/GLVertexInput.c \
	$(LRPS2_DIR)/GS/Renderers/OpenGL/GSDeviceOGL.c \
	$(LRPS2_DIR)/GS/Renderers/OpenGL/GSTextureOGL.c
