# ============================================================================
# common
# ============================================================================
SOURCES_CXX += \
	$(LRPS2_DIR)/HostFS.cpp \

# common/emitter is the x86-only JIT code emitter. On aarch64 the recompilers
# that use it are gated out (VIXL is the arm64 emitter instead), so exclude it
# stays on both (it has an __aarch64__ path).
# The reference emitter implementation lives with the verification harness in
# tests/emitter/reference: it is what the byte oracles compare the C89 core
# against. The switched build (C89_EMITTER=1) emits everything through the
# header-only core in common/emitter/c89emit.h and compiles none of these.
ifneq ($(IS_ARM64), 1)
ifneq ($(C89_EMITTER), 1)
SOURCES_CXX += \
	$(CORE_DIR)/tests/emitter/reference/avx.cpp \
	$(CORE_DIR)/tests/emitter/reference/groups.cpp \
	$(CORE_DIR)/tests/emitter/reference/jmp.cpp \
	$(CORE_DIR)/tests/emitter/reference/legacy.cpp \
	$(CORE_DIR)/tests/emitter/reference/legacy_sse.cpp \
	$(CORE_DIR)/tests/emitter/reference/movs.cpp \
	$(CORE_DIR)/tests/emitter/reference/simd.cpp \
	$(CORE_DIR)/tests/emitter/reference/x86emitter.cpp
endif
endif

