# pcsx2/GS/Renderers/SW - the software renderer, on every architecture.
SOURCES_C += \
	$(LRPS2_DIR)/GS/Renderers/SW/GSDeviceSW.c \
	$(LRPS2_DIR)/GS/Renderers/SW/GSDrawScanline.c \
	$(LRPS2_DIR)/GS/Renderers/SW/GSRaster.c \
