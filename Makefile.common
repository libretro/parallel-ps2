SOURCES_CXX :=
SOURCES_C   :=
SOURCES_CC  :=
SOURCES_ASM :=

# ----------------------------------------------------------------------------
# Directories
# ----------------------------------------------------------------------------
DEPS_DIR          := $(CORE_DIR)/3rdparty
LIBRETRO_DIR      := $(CORE_DIR)/libretro
LIBRETRO_COMM_DIR := $(LIBRETRO_DIR)/libretro-common
COMMON_DIR        := $(CORE_DIR)/common
LRPS2_DIR         := $(CORE_DIR)/pcsx2
PGS_DIR           := $(LRPS2_DIR)/GS/parallel-gs
GRANITE_DIR       := $(PGS_DIR)/Granite

# ----------------------------------------------------------------------------
# Include flags
# ----------------------------------------------------------------------------
# Mirrors what the cmake LIBRETRO=ON build resolves to for pcsx2_libretro/PCSX2/
# common targets.  Order matters: project headers first, then 3rdparty.
INCFLAGS := \
	-I$(CORE_DIR) \
	-I$(LRPS2_DIR) \
	-I$(LRPS2_DIR)/x86 \
	-I$(COMMON_DIR) \
	-I$(COMMON_DIR)/include \
	-I$(LIBRETRO_DIR) \
	-I$(LIBRETRO_COMM_DIR)/include \
	-I$(DEPS_DIR) \
	-I$(DEPS_DIR)/include \
	-I$(DEPS_DIR)/xbyak \

ifeq ($(HAVE_OPENGL), 1)
	INCFLAGS += -I$(DEPS_DIR)/glad/include
endif

ifeq ($(HAVE_VULKAN), 1)
	INCFLAGS += \
		-I$(DEPS_DIR)/vulkan-headers/include \
		-I$(DEPS_DIR)/glslang/glslang \
		-I$(DEPS_DIR)/glslang/include \
		-I$(GRANITE_DIR)/util \
		-I$(GRANITE_DIR)/vulkan \
		-I$(GRANITE_DIR)/application/global \
		-I$(GRANITE_DIR)/third_party/volk \
		-I$(PGS_DIR)/gs
endif

# ----------------------------------------------------------------------------
# Defines mirroring cmake's LIBRETRO=ON Windows build
# ----------------------------------------------------------------------------
ifeq ($(HAVE_OPENGL), 1)
	ifeq ($(GLES3), 1)
		FLAGS += -DHAVE_OPENGLES -DHAVE_OPENGLES3 -DENABLE_OPENGL
	else ifeq ($(GLES), 1)
		FLAGS += -DHAVE_OPENGLES -DHAVE_OPENGLES2 -DENABLE_OPENGL
	else
		FLAGS += -DHAVE_OPENGL -DCORE -DENABLE_OPENGL
	endif
endif

ifeq ($(HAVE_VULKAN), 1)
	FLAGS += -DHAVE_VULKAN -DENABLE_VULKAN -DHAVE_PARALLEL_GS \
		 -DGRANITE_SHIPPING
endif

ifeq ($(NEED_THREADING), 1)
	FLAGS += -DWANT_THREADING -DHAVE_THREADS
endif

ifeq ($(FRONTEND_SUPPORTS_RGB565), 1)
	FLAGS += -DFRONTEND_SUPPORTS_RGB565
endif

# ----------------------------------------------------------------------------
# AArch64 (arm64) recompiler backend (PR #143)
# ----------------------------------------------------------------------------
# VIXL is the AArch64 code emitter (aarch64 target only). The arm64 recompiler
# TUs include its headers, so its include dir and the two VIXL config defines
# must be visible to the whole core, not just the VIXL objects -- cmake sets
# them PUBLIC on the vixl target for exactly this reason.
ifeq ($(IS_ARM64), 1)
	INCFLAGS += -I$(DEPS_DIR)/vixl/src
	FLAGS    += -D_ARCH_64=1 \
	            -DVIXL_INCLUDE_TARGET_AARCH64
	# The staging buffer grows via mremap() on Linux; Darwin has no mremap,
	# so it uses VIXL's realloc backend there, same as upstream VIXL on Mac.
	ifneq (,$(filter osx ios% tvos%,$(platform)))
		FLAGS += -DVIXL_CODE_BUFFER_MALLOC
	else
		FLAGS += -DVIXL_CODE_BUFFER_MMAP
	endif
endif

CFLAGS   += $(FLAGS)
CXXFLAGS += $(FLAGS)

