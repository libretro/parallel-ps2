	$(LRPS2_DIR)/GS/Renderers/SW/GSTextureSW.c

# The renderer is portable: it is written against GSVector4/4i and
# gs_vector, which have NEON implementations. Only the code generators are
# x86-only (below); without them GSDrawScanline.c draws through its C
# rasterizer, which tests/swdraw runs on AArch64 in CI.
SOURCES_C += \
	$(LRPS2_DIR)/GS/Renderers/SW/GSRendererSW.c

ifneq ($(IS_ARM64), 1)
SOURCES_C += \
	$(LRPS2_DIR)/GS/Renderers/SW/GSJitX86.c \
	$(LRPS2_DIR)/GS/Renderers/SW/GSSetupPrimJit.c \
	$(LRPS2_DIR)/GS/Renderers/SW/GSDrawScanlineJit.c
endif

# pcsx2/GS/Renderers/OpenGL
ifeq ($(HAVE_OPENGL), 1)
