# pcsx2/GS/Renderers/SW - software renderer. The device + texture cache/texture
# build everywhere; the scanline JIT (GS*CodeGenerator) and rasterizer are x86
# xbyak codegen with no arm64 backend, so they are dropped on aarch64 (the HW
# renderer / paraLLEl-GS cover it; GS.cpp gates the SW path on ARCH_ARM64).
# Mirrors the `list(REMOVE_ITEM ... NOT _M_X86)` in pcsx2/CMakeLists.txt.
SOURCES_CXX += \
	$(LRPS2_DIR)/GS/Renderers/SW/GSDeviceSW.cpp \
	$(LRPS2_DIR)/GS/Renderers/SW/GSTextureCacheSW.cpp \
	$(LRPS2_DIR)/GS/Renderers/SW/GSTextureSW.cpp

# The rasterizer, the renderer and the scanline dispatcher are portable: they
# are written against GSVector4/4i, which have NEON implementations. Only the
# xbyak code generators are x86-only, and GSDrawScanline falls back to its C++
# reference path (CSetupPrim / CDrawScanline / CDrawEdge) without them.
SOURCES_CXX += \
	$(LRPS2_DIR)/GS/Renderers/SW/GSDrawScanline.cpp \
	$(LRPS2_DIR)/GS/Renderers/SW/GSRasterizer.cpp \
	$(LRPS2_DIR)/GS/Renderers/SW/GSRendererSW.cpp

ifneq ($(IS_ARM64), 1)
SOURCES_CXX += \
	$(LRPS2_DIR)/GS/Renderers/SW/GSDrawScanlineCodeGenerator.all.cpp \
	$(LRPS2_DIR)/GS/Renderers/SW/GSDrawScanlineCodeGenerator.cpp \
	$(LRPS2_DIR)/GS/Renderers/SW/GSSetupPrimCodeGenerator.all.cpp \
	$(LRPS2_DIR)/GS/Renderers/SW/GSSetupPrimCodeGenerator.cpp
endif

# pcsx2/GS/Renderers/OpenGL
ifeq ($(HAVE_OPENGL), 1)
SOURCES_CXX += \
	$(LRPS2_DIR)/GS/Renderers/OpenGL/GLContext.cpp \
	$(LRPS2_DIR)/GS/Renderers/OpenGL/GLProgram.cpp \
	$(LRPS2_DIR)/GS/Renderers/OpenGL/GLShaderCache.cpp \
	$(LRPS2_DIR)/GS/Renderers/OpenGL/GLState.cpp \
	$(LRPS2_DIR)/GS/Renderers/OpenGL/GLStreamBuffer.cpp \
	$(LRPS2_DIR)/GS/Renderers/OpenGL/GSDeviceOGL.cpp \
	$(LRPS2_DIR)/GS/Renderers/OpenGL/GSTextureOGL.cpp
endif

# pcsx2/GS/Renderers/Vulkan + parallel-gs
ifeq ($(HAVE_VULKAN), 1)
SOURCES_C += $(LRPS2_DIR)/GS/Renderers/Vulkan/GSVulkanHeap.c

SOURCES_CXX += \
	$(LRPS2_DIR)/GS/Renderers/Vulkan/GSDeviceVK.cpp \
	$(LRPS2_DIR)/GS/Renderers/Vulkan/GSTextureVK.cpp \
	$(LRPS2_DIR)/GS/Renderers/Vulkan/VKBuilders.cpp \
	$(LRPS2_DIR)/GS/Renderers/Vulkan/VKLoader.cpp \
	$(LRPS2_DIR)/GS/Renderers/Vulkan/VKShaderCache.cpp \
	$(LRPS2_DIR)/GS/Renderers/Vulkan/VKStreamBuffer.cpp \
	\
	$(LRPS2_DIR)/GS/Renderers/parallel-gs/GSRendererPGS.cpp
endif

# pcsx2/GS/Renderers/DX11/DX12 (Windows only)
ifeq ($(IS_WINDOWS), 1)
SOURCES_CXX += \
	$(LRPS2_DIR)/GS/Renderers/DX11/D3D.cpp \
	$(LRPS2_DIR)/GS/Renderers/DX11/D3D11ShaderCache.cpp \
	$(LRPS2_DIR)/GS/Renderers/DX11/GSDevice11.cpp \
	$(LRPS2_DIR)/GS/Renderers/DX11/GSTexture11.cpp \
	\
	$(LRPS2_DIR)/GS/Renderers/DX12/D3D12Builders.cpp \
	$(LRPS2_DIR)/GS/Renderers/DX12/D3D12DescriptorHeapManager.cpp \
	$(LRPS2_DIR)/GS/Renderers/DX12/D3D12ShaderCache.cpp \
	$(LRPS2_DIR)/GS/Renderers/DX12/D3D12StreamBuffer.cpp \
	$(LRPS2_DIR)/GS/Renderers/DX12/GSDevice12.cpp \
	$(LRPS2_DIR)/GS/Renderers/DX12/GSTexture12.cpp
endif

# ============================================================================
# parallel-gs + Granite (Vulkan only)
# ============================================================================
ifeq ($(HAVE_VULKAN), 1)
# parallel-gs core
SOURCES_CXX += \
	$(PGS_DIR)/gs/gs_interface.cpp \
	$(PGS_DIR)/gs/gs_renderer.cpp \
	$(PGS_DIR)/gs/gs_util.cpp \
	$(PGS_DIR)/gs/page_tracker.cpp

# Granite math is gone entirely: nothing in paraLLEl-GS or the Granite subset
# this core links uses it. The vector types the GS code needs are plain
# aggregates in shaders/data_structures.h, and anything arithmetic on a pair
# goes through gs/pgs_vertex_kernels.h.

# Granite util
# cli_parser, dynamic_library, message_queue are excluded: their consumers
# (viewer/slangmosh tools, audio mixer, ffmpeg decode, thread group, wsi_dxgi)
# are not built in the libretro core.
# string_helpers and thread_priority are also excluded: nm shows none of their
# defined symbols are referenced anywhere we link in.
# timeline_trace_file is needed because Granite's vulkan/device.cpp calls
# allocate_event/submit_event directly on system_handles.timeline_trace_file
# (only the GRANITE_SCOPED_TIMELINE_EVENT macros are GRANITE_SHIPPING-gated).
SOURCES_CXX += \
	$(GRANITE_DIR)/util/aligned_alloc.cpp \
	$(GRANITE_DIR)/util/arena_allocator.cpp \
	$(GRANITE_DIR)/util/environment.cpp \
	$(GRANITE_DIR)/util/logging.cpp \
	$(GRANITE_DIR)/util/slab_allocator.cpp \
	$(GRANITE_DIR)/util/thread_id.cpp \
	$(GRANITE_DIR)/util/thread_name.cpp \
	$(GRANITE_DIR)/util/timeline_trace_file.cpp \
	$(GRANITE_DIR)/util/timer.cpp

# Granite vulkan
# wsi.cpp and wsi_dxgi.cpp are excluded: the libretro core integrates with the
# frontend's swapchain via retro_vulkan_* callbacks (pgs_create_device etc.)
# and does not call any Vulkan::WSI methods. Excluding wsi.cpp also avoids the
# vkAcquireFullScreenExclusiveModeEXT / vkGetPhysicalDeviceSurfacePresentModes2EXT
# undefineds it pulls in.
# pipeline_event and event_manager are gone rather than merely excluded: the
# comment here used to claim pipeline_event was excluded while line 597 built
# it anyway. paraLLEl-GS does not use Vulkan events for inter-pass
# synchronisation, and every signal_event / wait_events / begin_signal_event /
# request_pipeline_event occurrence in the subtree was a definition, never a
# call, so the whole mechanism and its two source files were removed.
SOURCES_CXX += \
	$(GRANITE_DIR)/vulkan/breadcrumbs.cpp \
	$(GRANITE_DIR)/vulkan/buffer.cpp \
	$(GRANITE_DIR)/vulkan/buffer_pool.cpp \
	$(GRANITE_DIR)/vulkan/command_buffer.cpp \
	$(GRANITE_DIR)/vulkan/command_pool.cpp \
	$(GRANITE_DIR)/vulkan/context.cpp \
	$(GRANITE_DIR)/vulkan/cookie.cpp \
	$(GRANITE_DIR)/vulkan/descriptor_set.cpp \
	$(GRANITE_DIR)/vulkan/device.cpp \
	$(GRANITE_DIR)/vulkan/fence.cpp \
	$(GRANITE_DIR)/vulkan/fence_manager.cpp \
	$(GRANITE_DIR)/vulkan/image.cpp \
	$(GRANITE_DIR)/vulkan/memory_allocator.cpp \
	$(GRANITE_DIR)/vulkan/pipeline_cache.cpp \
	$(GRANITE_DIR)/vulkan/query_pool.cpp \
	$(GRANITE_DIR)/vulkan/render_pass.cpp \
	$(GRANITE_DIR)/vulkan/sampler.cpp \
	$(GRANITE_DIR)/vulkan/semaphore.cpp \
	$(GRANITE_DIR)/vulkan/semaphore_manager.cpp \
	$(GRANITE_DIR)/vulkan/shader.cpp \
	$(GRANITE_DIR)/vulkan/texture/texture_format.cpp

# Granite volk (C, single TU)
SOURCES_C += $(GRANITE_DIR)/third_party/volk/volk.c
endif

# ============================================================================
# 3rdparty - always-on dependencies
# ============================================================================

# zlib: gone.  Every former consumer runs on libretro-common's clean-room
# codecs - CHD hunks through rchd, CSO frames and indexed .gz through
# rinflate (with the zran primitives), rpng through trans_stream_deflate.

# PNG: libretro-common's rpng (rinflate-native via trans_stream),
# replacing vendored libpng for the read-only texture loader.
SOURCES_C += \
	$(LIBRETRO_COMM_DIR)/formats/png/rpng.c \
	$(LIBRETRO_COMM_DIR)/streams/trans_stream.c \
	$(LIBRETRO_COMM_DIR)/streams/trans_stream_deflate.c \
	$(LIBRETRO_COMM_DIR)/streams/trans_stream_pipe.c

# lz4: gone.  ZSO frames decode through libretro-common's clean-room
# rlz4 block decoder.
SOURCES_C += $(LIBRETRO_COMM_DIR)/encodings/encoding_rlz4.c

# CHD: libretro-common's clean-room rchd stack (rchd + rflac + rzstd +
# r7z_lzma + huffman/deflate/crc32), replacing vendored libchdr.  The
# decoder does no I/O of its own - ChdFileReader drives it, feeding from
# a mapped image when the VFS provides one.
SOURCES_C += \
	$(LIBRETRO_COMM_DIR)/formats/chd/rchd.c \
	$(LIBRETRO_COMM_DIR)/formats/flac/rflac.c \
	$(LIBRETRO_COMM_DIR)/formats/yaml/ryaml.c \
	$(LIBRETRO_COMM_DIR)/formats/7z/r7z_lzma.c \
	$(LIBRETRO_COMM_DIR)/encodings/encoding_rzstd.c \
	$(LIBRETRO_COMM_DIR)/encodings/encoding_huffman.c \
	$(LIBRETRO_COMM_DIR)/encodings/encoding_deflate.c \
	$(LIBRETRO_COMM_DIR)/encodings/encoding_crc32.c

# Which of rchd's hunk codecs are compiled in.  Stated here rather than
# left to rchd.c's fallback: that fallback turns on DEFLATE and LZMA
# unconditionally but gates FLAC and Zstandard behind HAVE_FLAC/HAVE_RFLAC
# and HAVE_ZSTD/HAVE_RZSTD, which this build has never defined.  The
# result was a reader that linked rflac.c and encoding_rzstd.c and then
# refused every 'cdfl' and 'cdzs' hunk with RCHD_ERROR_UNSUPPORTED - a
# per-hunk failure, so an image opened, reported correct geometry and a
# correct TOC, and only died on the fraction of hunks that happened to
# pick those codecs.  All four objects are in SOURCES_C above, so all
# four codecs are named here.
FLAGS += -DHAVE_RCHD_DEFLATE -DHAVE_RCHD_LZMA \
         -DHAVE_RCHD_FLAC -DHAVE_RCHD_ZSTD

# ----------------------------------------------------------------------------
# VIXL - vendored aarch64-only subset (3rdparty/vixl); the AArch64 code emitter
# backing the arm64 recompiler. Built only on aarch64. Sources are .cc, so they
# live in SOURCES_CC; -w is applied to their objects in the top Makefile (third
# party -- matches cmake's `-w` on the vixl target). Globbed to match cmake's
# file(GLOB) so a VIXL bump doesn't need this list touched.
# ----------------------------------------------------------------------------
ifeq ($(IS_ARM64), 1)
SOURCES_CC += \
	$(wildcard $(DEPS_DIR)/vixl/src/*.cc) \
	$(wildcard $(DEPS_DIR)/vixl/src/aarch64/*.cc)
endif

# glad (OpenGL)
ifeq ($(HAVE_OPENGL), 1)
SOURCES_C += $(DEPS_DIR)/glad/src/glad.c
endif

# glslang (Vulkan only)
ifeq ($(HAVE_VULKAN), 1)
SOURCES_CXX += \
	$(DEPS_DIR)/glslang/glslang/glslang/CInterface/glslang_c_interface.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/GenericCodeGen/CodeGen.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/GenericCodeGen/Link.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/attribute.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/Constant.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/glslang_tab.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/InfoSink.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/Initialize.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/Intermediate.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/intermOut.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/IntermTraverse.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/iomapper.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/limits.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/linkValidate.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/parseConst.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/ParseContextBase.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/ParseHelper.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/PoolAlloc.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/preprocessor/Pp.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/preprocessor/PpAtom.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/preprocessor/PpContext.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/preprocessor/PpScanner.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/preprocessor/PpTokens.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/propagateNoContraction.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/reflection.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/RemoveTree.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/Scan.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/ShaderLang.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/SpirvIntrinsics.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/SymbolTable.cpp \
	$(DEPS_DIR)/glslang/glslang/glslang/MachineIndependent/Versions.cpp \
	$(DEPS_DIR)/glslang/glslang/OGLCompilersDLL/InitializeDll.cpp \
	$(DEPS_DIR)/glslang/glslang/SPIRV/disassemble.cpp \
	$(DEPS_DIR)/glslang/glslang/SPIRV/doc.cpp \
	$(DEPS_DIR)/glslang/glslang/SPIRV/GlslangToSpv.cpp \
	$(DEPS_DIR)/glslang/glslang/SPIRV/InReadableOrder.cpp \
	$(DEPS_DIR)/glslang/glslang/SPIRV/Logger.cpp \
	$(DEPS_DIR)/glslang/glslang/SPIRV/SpvBuilder.cpp \
	$(DEPS_DIR)/glslang/glslang/SPIRV/SpvPostProcess.cpp \
	$(DEPS_DIR)/glslang/glslang/SPIRV/SPVRemapper.cpp \
	$(DEPS_DIR)/glslang/glslang/SPIRV/SpvTools.cpp \
	$(DEPS_DIR)/glslang/glslang/StandAlone/ResourceLimits.cpp \
	$(DEPS_DIR)/glslang/glslang/StandAlone/resource_limits_c.cpp

# glslang OS bindings: Windows variant on win32, Unix variant elsewhere.
ifeq ($(IS_WINDOWS), 1)
SOURCES_CXX += $(DEPS_DIR)/glslang/glslang/glslang/OSDependent/Windows/ossource.cpp
else
SOURCES_CXX += $(DEPS_DIR)/glslang/glslang/glslang/OSDependent/Unix/ossource.cpp
endif
endif

# Dynamically loaded builds only: statically linked frontends share one
# libretro-common with the core, and vfs_hybrid.o's reference to
# filestream_set_mapped_ptr_cb can pull this tree's file_stream.o into
# symbol collision with griffin.
ifneq ($(STATIC_LINKING), 1)
SOURCES_C += $(LIBRETRO_COMM_DIR)/vfs/vfs_hybrid.c
endif

# Opt-in profiler source (see PROFILER=1 in the top-level Makefile).
ifeq ($(PROFILER), 1)
SOURCES_CXX += \
	$(LRPS2_DIR)/Profiler.cpp
endif
