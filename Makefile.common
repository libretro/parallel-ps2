	$(LRPS2_DIR)/GS/Renderers/DX11/GSTexture11.c \
	$(LRPS2_DIR)/GS/Renderers/DX12/D3D12Builders.c \
	$(LRPS2_DIR)/GS/Renderers/DX12/D3D12DescriptorHeapManager.c \
	$(LRPS2_DIR)/GS/Renderers/DX12/D3D12ShaderCache.c \
	$(LRPS2_DIR)/GS/Renderers/DX12/D3D12StreamBuffer.c \
