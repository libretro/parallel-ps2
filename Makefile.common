	$(LRPS2_DIR)/GS/Renderers/OpenGL/GLContext.c \
	$(LRPS2_DIR)/GS/Renderers/OpenGL/GLProgram.c \
	$(LRPS2_DIR)/GS/Renderers/OpenGL/GLProgramCache.c \
