"#ifdef ps_yuv\n"
"uniform ivec2 EMOD;\n"
"\n"
"void ps_yuv()\n"
"{\n"
"	vec4 i = sample_c();\n"
"	vec4 o = vec4(0.0f);\n"
"\n"
"	mat3 rgb2yuv; // Value from GS manual\n"
"	rgb2yuv[0] = vec3(0.587, -0.311, -0.419);\n"
"	rgb2yuv[1] = vec3(0.114, 0.500, -0.081);\n"
