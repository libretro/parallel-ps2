"}\n"
"#endif\n"
"\n"
"#ifdef ps_convert_rgb5a1_float16\n"
"void ps_convert_rgb5a1_float16()\n"
"{\n"
"	// Convert an RGB5A1 (saved as RGBA8) color to a 16 bit Z\n"
